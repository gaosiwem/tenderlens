# TenderLens Backend Environment Variables
NODE_ENV=development
PORT=8080

DATABASE_URL="postgresql://tenderlens:%40Tenderlensapp10111@localhost:5432/tenderlens_db?schema=public"

# Cross-Origin Resource Sharing
CORS_ORIGINS="http://127.0.0.1:3000"
CORS_ALLOW_NO_ORIGIN_PATHS="/health,/ready,/api/v1/billing/payfast/notify,/api/v1/payouts/webhook"

# Secrets (Change these in production!)
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# JWT Settings
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Cookie Settings
COOKIE_SECURE=false
COOKIE_DOMAIN=""

# Redis
REDIS_URL="redis://localhost:6379"

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH="./storage"
MAX_UPLOAD_MB=20

# S3 (Required if STORAGE_DRIVER=s3)
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Supabase Storage via S3 compatibility (Required if STORAGE_DRIVER=supabase)
# These values can coexist with the generic S3 vars above, but when
# STORAGE_DRIVER=supabase the SUPABASE_* values take precedence.
SUPABASE_S3_REGION=auto
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_FORCE_PATH_STYLE=true

# AI & OCR
ENABLE_OCR=true
OCR_LANG=eng
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
EMBEDDINGS_MODEL=text-embedding-3-small

# Billing
CREDITS_ENABLED=true
BACKEND_PUBLIC_URL="http://127.0.0.1:8080"
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL="http://127.0.0.1:3000/billing/success"
PAYFAST_CANCEL_URL="http://127.0.0.1:3000/billing/cancel"
PAYFAST_NOTIFY_URL="http://127.0.0.1:8080/api/v1/billing/payfast/notify"
DEV_TEST_ROUTES_ENABLED=false
PAYOUT_WEBHOOK_SECRET=

# Legacy Stripe settings (unused for PayFast billing flow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_SUCCESS_URL="http://localhost:3005/billing/success"
STRIPE_CANCEL_URL="http://localhost:3005/billing/cancel"


# Email Configuration (SMTP)
# Please Replace with your actual credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gaosiwem@gmail.com
SMTP_PASS=
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_FROM="TenderLens <no-reply@tenderlens.co.za>"
EMAIL_TEST_OVERRIDE_TO="gaosiwem@gmail.com"
EMAIL_BRAND_NAME="TenderLens"
EMAIL_BRAND_LOGO_URL=
EMAIL_BRAND_PRIMARY_COLOR="#0f766e"
EMAIL_BRAND_BACKGROUND_COLOR="#f5f7fb"
EMAIL_BRAND_CARD_COLOR="#ffffff"
EMAIL_BRAND_TEXT_COLOR="#111827"
EMAIL_BRAND_MUTED_COLOR="#6b7280"
EMAIL_BRAND_BORDER_COLOR="#e5e7eb"
EMAIL_BRAND_FOOTER_TEXT="This message was sent by TenderLens notifications."
WATCHLIST_BATCH_WINDOW_MINUTES=30
WATCHLIST_MAX_EMAILS_PER_DAY=3
WATCHLIST_MAX_TENDERS_PER_EMAIL=10
WATCHLIST_URGENT_REMINDER_TYPES="CLOSING_2H"
WATCHLIST_BATCHED_REMINDER_TYPES="CLOSING_7D,CLOSING_24H,SITE_VISIT"

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0


# SMS
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_FROM_NUMBER=
SMS_VERIFICATION_ENABLED=true
SMS_OTP_TTL_MINUTES=10
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_RATE_LIMIT_PER_HOUR=5

# billing
# cost (in credits) for sending each SMS notification message
COST_SMS_NOTIFICATION=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Feature Flags
TEAM_COLLAB_ENABLED=true
MENTIONS_ENABLED=true
TASK_REMINDERS_ENABLED=true
SOCKET_ENABLED=true
SOCKET_CORS_ORIGIN="http://localhost:3005"
GOVERNANCE_STRICT=true
Checklist_ENABLED=true
TENDER_COMPARE_ENABLED=true
BUSINESS_SUPPORT_SLA_ENABLED=true
BUSINESS_SUPPORT_SLA_CRON="*/10 * * * *"

# TenderLens Backend Environment Variables
NODE_ENV=development
PORT=8080

DATABASE_URL="postgresql://TenderLens:@TenderLens10111@localhost:5432/tenderlens?schema=public"

# Cross-Origin Resource Sharing
CORS_ORIGINS="http://localhost:3005"

# Secrets (Change these in production!)
JWT_SECRET=6e8f1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a
JWT_ACCESS_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
JWT_REFRESH_SECRET=c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4
COOKIE_SECRET=e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6

# JWT Settings
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Cookie Settings
COOKIE_SECURE=false
COOKIE_DOMAIN=""

# Redis
REDIS_URL="redis://localhost:6379"

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH="./storage"
MAX_UPLOAD_MB=20

# S3 (Required if STORAGE_DRIVER=s3)
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# AI & OCR
ENABLE_OCR=true
OCR_LANG=eng
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
EMBEDDINGS_MODEL=text-embedding-3-small

# Billing & Stripe
CREDITS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_SUCCESS_URL="http://localhost:3005/billing/success"
STRIPE_CANCEL_URL="http://localhost:3005/billing/cancel"


# Email Configuration (SMTP)
# Please Replace with your actual credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gaosiwem@gmail.com
SMTP_PASS=
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_FROM="TenderLens <no-reply@tenderlens.co.za>"
EMAIL_TEST_OVERRIDE_TO="gaosiwem@gmail.com"
EMAIL_BRAND_NAME="TenderLens"
EMAIL_BRAND_LOGO_URL=
EMAIL_BRAND_PRIMARY_COLOR="#0f766e"
EMAIL_BRAND_BACKGROUND_COLOR="#f5f7fb"
EMAIL_BRAND_CARD_COLOR="#ffffff"
EMAIL_BRAND_TEXT_COLOR="#111827"
EMAIL_BRAND_MUTED_COLOR="#6b7280"
EMAIL_BRAND_BORDER_COLOR="#e5e7eb"
EMAIL_BRAND_FOOTER_TEXT="This message was sent by TenderLens notifications."
WATCHLIST_BATCH_WINDOW_MINUTES=30
WATCHLIST_MAX_EMAILS_PER_DAY=3
WATCHLIST_MAX_TENDERS_PER_EMAIL=10
WATCHLIST_URGENT_REMINDER_TYPES="CLOSING_2H"
WATCHLIST_BATCHED_REMINDER_TYPES="CLOSING_7D,CLOSING_24H,BRIEFING_SESSION,SITE_VISIT"


# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_FROM_NUMBER=

# billing
# cost (in credits) for sending each WhatsApp notification message
COST_WHATSAPP_NOTIFICATION=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Feature Flags
TEAM_COLLAB_ENABLED=true
MENTIONS_ENABLED=true
TASK_REMINDERS_ENABLED=true
SOCKET_ENABLED=true
GOVERNANCE_STRICT=true
Checklist_ENABLED=true
TENDER_COMPARE_ENABLED=true
BUSINESS_SUPPORT_SLA_ENABLED=true
BUSINESS_SUPPORT_SLA_CRON="*/10 * * * *"

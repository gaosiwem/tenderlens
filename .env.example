# TenderLens Infrastructure Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration (Docker)
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=tenderlens_db
DB_PORT=5432

# Redis Configuration (Docker)
REDIS_PORT=6379

# Backend Configuration
PORT=8080
DATABASE_URL=postgresql://<db_user>:<db_password>@db:5432/tenderlens_db?schema=public
REDIS_URL=redis://redis:6379
NODE_ENV=development
MARKETING_DOMAIN=tenderlens.co.za
APP_DOMAIN=app.tenderlens.co.za
API_DOMAIN=api.tenderlens.co.za
CORS_ORIGINS=http://localhost:3005
CORS_ALLOW_NO_ORIGIN_PATHS=/health,/ready,/api/v1/billing/payfast/notify,/api/v1/payouts/webhook
SOCKET_CORS_ORIGIN=http://localhost:3005

# Secrets (Change these in production!)
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MARKETING_URL=https://tenderlens.co.za
NEXT_PUBLIC_APP_URL=https://app.tenderlens.co.za
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# External Services (Keys required for production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
DEV_TEST_ROUTES_ENABLED=false
PAYOUT_WEBHOOK_SECRET=

# Auth Flows
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# eTenders scraper resilience (optional tuning)
ETENDERS_FEED_FETCH_ATTEMPTS=6
ETENDERS_FEED_FETCH_TIMEOUT_MS=45000
ETENDERS_FEED_RETRY_BASE_DELAY_MS=1500
ETENDERS_IMPORT_BATCH_SIZE=100
ETENDERS_IMPORT_CANCELLED_BATCH_SIZE=25

# TenderLens Infrastructure Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration (Docker)
POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=tenderlens_db
DB_PORT=5432

# Redis Configuration (Docker)
REDIS_PORT=6379

# Backend Configuration
PORT=8080
DATABASE_URL=postgresql://<db_user>:<db_password>@db:5432/tenderlens_db?schema=public
REDIS_URL=redis://redis:6379
NODE_ENV=development
MARKETING_DOMAIN=tenderlens.co.za
APP_DOMAIN=app.tenderlens.co.za
API_DOMAIN=api.tenderlens.co.za
CORS_ORIGINS=http://localhost:3005
CORS_ALLOW_NO_ORIGIN_PATHS=/health,/ready,/api/v1/billing/payfast/notify,/api/v1/payouts/webhook
SOCKET_CORS_ORIGIN=http://localhost:3005

# Secrets (Change these in production!)
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MARKETING_URL=https://tenderlens.co.za
NEXT_PUBLIC_APP_URL=https://app.tenderlens.co.za
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# External Services (Keys required for production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RECONCILIATION_ENABLED=true
PAYFAST_RECONCILIATION_CRON="15 * * * *"
PAYFAST_GRACE_DAYS=7
OPENAI_API_KEY=
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
DEV_TEST_ROUTES_ENABLED=false
PAYOUT_WEBHOOK_SECRET=

# SMS (SMTP2GO)
SMS_ENABLED=false
# Use SMS_PROVIDER=log for local OTP testing without sending real SMS.
SMS_PROVIDER=smtp2go
SMS_FROM_NUMBER=
SMTP2GO_SMS_API_URL=https://api.smtp2go.com/v3/sms/send
SMTP2GO_API_KEY=
SMTP2GO_SMS_SENDER=

# Legacy SMS South Africa / MyMobileAPI provider (SMS_PROVIDER=smssouthafrica)
SMSSOUTHAFRICA_API_URL=https://rest.mymobileapi.com/v3/BulkMessages
SMSSOUTHAFRICA_CLIENT_ID=
SMSSOUTHAFRICA_CLIENT_SECRET=
SMSSOUTHAFRICA_SENDER_ID=
SMSSOUTHAFRICA_TEST_MODE=false

# Auth Flows
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# AI Compliance Auditor
COMPLIANCE_AUDITOR_ENABLED=true
COMPLIANCE_AUDITOR_MODEL=gpt-4o-mini
COMPLIANCE_AUDITOR_MAX_TOKENS=1800
COMPLIANCE_AUDITOR_MAX_CHUNKS=40
COMPLIANCE_AUDITOR_QUEUE_ENABLED=true
COMPLIANCE_AUDITOR_SCORE_PASS=80
COMPLIANCE_AUDITOR_SCORE_WARNING=60
BID_REVIEWER_ENABLED=true
BID_REVIEWER_MODEL=gpt-4o-mini
BID_REVIEWER_MAX_TOKENS=2200
BID_REVIEWER_MAX_TENDER_CHUNKS=30
BID_REVIEWER_MAX_PROPOSAL_CHUNKS=50
BID_REVIEWER_QUEUE_ENABLED=true
BID_REVIEWER_SCORE_PASS=80
BID_REVIEWER_SCORE_WARNING=60

# eTenders scraper resilience (optional tuning)
ETENDERS_FEED_FETCH_ATTEMPTS=6
ETENDERS_FEED_FETCH_TIMEOUT_MS=45000
ETENDERS_FEED_RETRY_BASE_DELAY_MS=1500
ETENDERS_IMPORT_BATCH_SIZE=100
ETENDERS_IMPORT_CANCELLED_BATCH_SIZE=25
ETENDERS_AUTO_IMPORT_ENABLED=true
ETENDERS_AUTO_IMPORT_CRON=0 0 * * *
ETENDERS_AUTO_IMPORT_TIMEZONE=Africa/Johannesburg
ETENDERS_AUTO_IMPORT_STATUSES=1,2,3,4
ETENDERS_AUTO_IMPORT_LIMIT=250
ETENDERS_AUTO_IMPORT_START=0
ETENDERS_AUTO_IMPORT_WINDOW_HOURS=24
ETENDERS_AUTO_IMPORT_STOP_ON_EXISTING=false
ETENDERS_AUTO_IMPORT_USER_EMAIL=system+etenders-import@tenderlens.local
